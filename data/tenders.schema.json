{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honzakud.github.io/sb-tender-radar/data/tenders.schema.json",
  "title": "S&B Tender Radar dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "coverage",
    "tenders"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geography",
        "historyFrom",
        "products",
        "note"
      ],
      "properties": {
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "historyFrom": {
          "type": "string",
          "format": "date"
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Malorážové střelivo",
              "Speciální a cvičné střelivo",
              "Komponenty střeliva"
            ]
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tender"
      }
    }
  },
  "$defs": {
    "dateOrNull": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "tender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "buyer",
        "country",
        "region",
        "productArea",
        "calibers",
        "status",
        "relevance",
        "value",
        "currency",
        "publishedAt",
        "deadline",
        "firstSeen",
        "lastChecked",
        "isNew",
        "changedFields",
        "summary",
        "managementNote",
        "risks",
        "verification",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240
        },
        "buyer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "country": {
          "type": "string",
          "minLength": 2
        },
        "region": {
          "type": "string",
          "minLength": 2
        },
        "productArea": {
          "enum": [
            "Malorážové střelivo",
            "Speciální a cvičné střelivo",
            "Komponenty střeliva"
          ]
        },
        "calibers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "active",
            "upcoming",
            "watch",
            "closed",
            "awarded"
          ]
        },
        "relevance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "publishedAt": {
          "$ref": "#/$defs/dateOrNull"
        },
        "deadline": {
          "$ref": "#/$defs/dateOrNull"
        },
        "firstSeen": {
          "type": "string",
          "format": "date"
        },
        "lastChecked": {
          "type": "string",
          "format": "date"
        },
        "isNew": {
          "type": "boolean"
        },
        "changedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "managementNote": {
          "type": "string",
          "minLength": 10
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "verification": {
          "type": "string",
          "minLength": 5
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}